# web_downloader.py - minimal .env template
# Copy to .env and set URL. For site-specific profiles see dds/profiles/.
#
# -- Quick start --------------------------------------------------------------
#
#   cp .env.example .env                              # generic public site
#   cp profiles/.env.bytebytego-courses .env         # ByteByteGo courses
#   cp profiles/.env.bytebytego-guides .env          # ByteByteGo guides
#   cp profiles/.env.wqu .env                        # learn.wqu.edu
#
# -- Minimum required ---------------------------------------------------------

URL=https://example.com/

# -- Common optional settings -------------------------------------------------

# Restrict the crawl to a path subtree.
# URL_PREFIX=/docs/

# Cookies from DevTools for authenticated sites.
# COOKIE=session=abc123; user_id=42

# Extra HTTP headers (HEADER_<NAME>=value becomes "<Name>: value").
# HEADER_AUTHORIZATION=Bearer eyJ...

# Enable Playwright headless Chromium for JavaScript-rendered sites.
# PLAYWRIGHT=true
# WAIT_FOR=article, main
# RENDER_SETTLE_MS=4000

# Output folder (default: derived from URL hostname).
# DESTINATION=~/Downloads/my-archive

# Concurrent download workers.
# THREADS=1

# Hard limit on pages crawled.
# MAX_PAGES=

# Include CDN assets (fonts/images from other domains).
# DOWNLOAD_EXTERNAL_ASSETS=true
# EXTERNAL_DOMAINS=cdn.example.com, fonts.gstatic.com

# Detailed auth/network diagnostics in trace.jsonl.
# AUTH_DEBUG=true
