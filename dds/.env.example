# web_downloader.py local config example
# Copy this file to .env and then keep only the website profile you need.
# Run with: uv run python web_downloader.py
#
# Profiles in this file:
# - ByteByteGo course root with auto-discovery
# - ByteByteGo exact lesson URLs
# - learn.wqu.edu exact lesson URLs via PLAYWRIGHT_STORAGE_STATE + REMOVE_JS=true

# ── Step 1: URL ───────────────────────────────────────────────────────────

URL=https://bytebytego.com/courses/tech-resume/

# Optional additional starting URLs.
# Accepted formats: JSON array, comma-separated, newline-separated, or spaces.
# Use this for simple "download exactly these pages" runs.
# START_URLS=["https://bytebytego.com/courses/tech-resume/p0-c2-introduction","https://bytebytego.com/courses/tech-resume/p1-c2-the-hiring-pipeline"]
# START_URLS=https://bytebytego.com/courses/tech-resume/p0-c2-introduction, https://bytebytego.com/courses/tech-resume/p1-c2-the-hiring-pipeline

# Restrict the crawl to pages under this path — prevents the crawler from
# following navbar links to /pricing, /our-team, /guides, etc.
# Set to the common prefix of all pages you want to download.
URL_PREFIX=/courses/

# Auto-discover chapter URLs from the course root page.
# Set true for ByteByteGo-style course sites with JS-driven navigation.
DISCOVER_CHAPTERS=true

# ── Step 2: COOKIE ─────────────────────────────────────────────────────────
#
# Replace the PASTE_HERE words below with your copied values:
# COOKIE=token=PASTE_HERE; cf_clearance=PASTE_HERE; csrf-token=PASTE_HERE

# If COOKIE includes cf_clearance, set USER_AGENT to the exact browser UA
# that solved the Cloudflare challenge (F12 -> Console -> navigator.userAgent).
# If USER_AGENT is not set, downloader auto-ignores cf_clearance.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36

# ── Step 3: Authorization header (only if needed) ────────────────────────
#
# If found, uncomment and paste the full "Bearer eyJ..." value below.
# If absent, leave commented (site uses cookies only).
# HEADER_AUTHORIZATION=Bearer PASTE_FULL_BEARER_TOKEN_HERE

# ── Step 4: Options ────────────────────────────────────────────────────────

# Stop downloading immediately if this text is detected on any page.
# "Unlock Full Access" is ByteByteGo's paywall message when you are logged out.
AUTH_FAIL_TEXT="Unlock Full Access"

# bytebytego.com is a Next.js SPA — Playwright is required to render content.
PLAYWRIGHT=true

# Use Playwright for chapter discovery, but fetch final chapter HTML via the
# authenticated requests session. This avoids guest/login regressions caused
# by client hydration on ByteByteGo.
PLAYWRIGHT_PAGE_FETCH=false

# Optional but recommended when cookie/header auth still fails:
# Generate with: uv run python capture_playwright_state.py --output playwright_state.json
# Also recommended for sites like learn.wqu.edu where login depends on browser
# state and the Application tab mostly shows non-auth/tracking cookies.
# PLAYWRIGHT_STORAGE_STATE=./playwright_state.json

# Keep Javascript in the saved HTML so Next.js can hydrate offline from
# embedded __NEXT_DATA__.
REMOVE_JS=false

# Wait for lessons to finish rendering before saving HTML.
WAIT_FOR=[class*="lesson"], article, main

# Extra wait after WAIT_FOR so auth/state hydration can settle in SPA.
RENDER_SETTLE_MS=4000

# Hide paywall buttons both in saved HTML and after offline hydration.
STRIP_SELECTORS=[class*="unlockAllBtn"]

# Auto-add Authorization: Bearer <token-cookie> when missing.
AUTO_AUTH_HEADER_FROM_COOKIE=true

# Set false for a simple explicit-URL mode (don't crawl discovered links).
FOLLOW_LINKS=true

# Set true to emit deep auth/network diagnostics to trace.jsonl.
AUTH_DEBUG=false

# 1 thread = safest (avoids rate limiting); increase cautiously.
# THREADS=1

# Override output folder (default: derived from the URL hostname).
# `~/Downloads/...` works on macOS and Windows.
# DESTINATION=~/Downloads/bytebytego-tech-resume

# Download fonts, images, etc. from CDN domains.
# DOWNLOAD_EXTERNAL_ASSETS=true
# EXTERNAL_DOMAINS=cdn.bytebytego.com, fonts.gstatic.com

# Max pages to crawl (leave unset = unlimited).
# MAX_PAGES=

# ── Step 5: Seed URLs (for sites with no <a> nav links) ───────────────────
#
# ByteByteGo sidebar uses JavaScript onClick — no <a href> links for chapters.
# List every chapter URL here only if you want manual force-queue mode.
#
# Keep commented in basic one-URL test mode.
# SEED_URLS=["https://bytebytego.com/courses/tech-resume/p0-acknowledgements","https://bytebytego.com/courses/tech-resume/p0-c2-introduction"]

# ── WQU example: exact lesson URLs via storage_state ───────────────────────
#
# First create browser state:
# uv run python capture_playwright_state.py \
#   --url https://learn.wqu.edu/my-courses/ \
#   --output playwright_state.json
#
# URL is optional in exact-URL mode when START_URLS is set.
# FOLLOW_LINKS=false
# START_URLS=["https://learn.wqu.edu/my-courses/courses/financial-markets/modules/m-1-credit-risk-and-financing/tasks/lesson-1-saving-borrowing-lesson-notes"]
# PLAYWRIGHT=true
# PLAYWRIGHT_PAGE_FETCH=true
# PLAYWRIGHT_STORAGE_STATE=./playwright_state.json
# REMOVE_JS=true
# WAIT_FOR=main, article
# THREADS=1
# DESTINATION=~/Downloads/wqu
