# web_downloader.py profile - ByteByteGo course content (paid)
# Copy to dds/.env, then fill in COOKIE before running.
#
# Target:   https://bytebytego.com/courses/<course-slug>/...
# Auth:     Short-lived JWT cookie (~1 hour). Refresh from F12 -> Network tab.
# Output:   dds/bytebytego_com/courses/<course-slug>/
# Notes:    Playwright handles chapter discovery only; protected page HTML is
#           fetched via the authenticated `requests` session (stable path).

# -- Target URL ---------------------------------------------------------------

URL=https://bytebytego.com/courses/tech-resume/
URL_PREFIX=/courses/

# Auto-discover all chapters from the course root (merges JSON API + DOM +
# sidebar data-menu-id + __NEXT_DATA__). Needed because ByteByteGo's sidebar
# uses JS onClick handlers, not <a href> links.
DISCOVER_CHAPTERS=true
FOLLOW_LINKS=false

# -- Auth (REQUIRED - paste before running) ----------------------------------
#
# F12 -> Network tab -> click any bytebytego.com request -> Request Headers ->
# right-click "Cookie:" value -> Copy value -> paste below (drop the "Cookie: "
# prefix).
#
# Token expires in ~1 hour. If you see "auth_failed_fatal", re-copy.
#
COOKIE=token=PASTE_HERE; csrf-token=PASTE_HERE

# Only needed if Cloudflare blocks without cf_clearance. If you include
# cf_clearance in COOKIE above, also set USER_AGENT to match your browser.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36

# -- Rendering / capture strategy --------------------------------------------

PLAYWRIGHT=true
PLAYWRIGHT_PAGE_FETCH=false
REMOVE_JS=false
WAIT_FOR=[class*="lesson"], article, main
RENDER_SETTLE_MS=4000

# Paywall detection + overlay removal
AUTH_FAIL_TEXT="Unlock Full Access"
STRIP_SELECTORS=[class*="unlockAllBtn"]

# Auto-derive Authorization: Bearer <token> from the token cookie.
AUTO_AUTH_HEADER_FROM_COOKIE=true

# -- Operational --------------------------------------------------------------

AUTH_DEBUG=false
# THREADS=1
# MAX_PAGES=
# DESTINATION=~/Downloads/bytebytego-tech-resume
