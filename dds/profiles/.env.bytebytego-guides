# web_downloader.py profile - ByteByteGo public guides
# Copy to dds/.env. No auth needed for most /guides/ content.
#
# Target:   https://bytebytego.com/guides/<article-or-category-slug>/
# Auth:     None (public articles)
# Output:   dds/output/bytebytego-guides/
# Notes:    /guides/ pages expose normal <a href> links, so we use normal
#           link-following (FOLLOW_LINKS=true) instead of chapter discovery.
#           Category and article pages are both flat under /guides/.

# -- Target URL ---------------------------------------------------------------

URL=https://bytebytego.com/guides/
URL_PREFIX=/guides/

# Normal link-crawl - guides aren't behind a JS-driven sidebar.
DISCOVER_CHAPTERS=false
FOLLOW_LINKS=true

# -- Auth (usually not needed) -----------------------------------------------
#
# Most /guides/ content is public. Only paste cookies here if a specific
# guide article shows a paywall.
# COOKIE=token=PASTE_HERE; csrf-token=PASTE_HERE

# -- Rendering ----------------------------------------------------------------

PLAYWRIGHT=true
PLAYWRIGHT_PAGE_FETCH=false
REMOVE_JS=false
WAIT_FOR=article, main
RENDER_SETTLE_MS=4000

# -- Operational --------------------------------------------------------------

AUTH_DEBUG=false
DESTINATION=./output/bytebytego-guides
# THREADS=1
# MAX_PAGES=
