# web_downloader.py profile - learn.wqu.edu lessons
# Copy to dds/.env.
#
# Target:   https://learn.wqu.edu/my-courses/courses/<slug>/modules/<slug>/tasks/<lesson-slug>
# Auth:     PLAYWRIGHT_STORAGE_STATE (captured via capture_playwright_state.py)
# Output:   ~/Downloads/wqu/ (override DESTINATION if you prefer)
# Notes:    WQU uses SSO / localStorage auth that CANNOT be reconstructed from
#           Application-tab cookies. You MUST capture a real logged-in browser
#           session first. WQU client JS breaks on file:// - REMOVE_JS=true.

# -- STEP 1: Capture browser state (ONE-TIME per login session) --------------
#
# Before running the downloader the first time, open a real browser and log in:
#
#   cd dds
#   uv run python capture_playwright_state.py \
#     --url https://learn.wqu.edu/my-courses/ \
#     --output playwright_state.json
#
# Log in manually in the opened browser, confirm a lesson is visible, then
# press Enter in the terminal to save playwright_state.json. Re-run this if
# your session expires.

# -- Target lesson URLs -------------------------------------------------------
#
# URL is optional when START_URLS is set and FOLLOW_LINKS=false.
# Paste one or more exact lesson URLs (JSON array format).

START_URLS=["https://learn.wqu.edu/my-courses/courses/financial-markets/modules/m-1-credit-risk-and-financing/tasks/lesson-1-saving-borrowing-lesson-notes"]
FOLLOW_LINKS=false

# -- Auth (storage state, not cookies) ---------------------------------------

PLAYWRIGHT_STORAGE_STATE=./playwright_state.json

# -- Rendering (different from ByteByteGo) -----------------------------------

PLAYWRIGHT=true
PLAYWRIGHT_PAGE_FETCH=true
REMOVE_JS=true
WAIT_FOR=main, article
RENDER_SETTLE_MS=4000

# -- Output -------------------------------------------------------------------

DESTINATION=~/Downloads/wqu
THREADS=1

# -- Operational --------------------------------------------------------------

AUTH_DEBUG=false
# MAX_PAGES=
